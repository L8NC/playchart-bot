# ────────────────────────────────────────────────────────────
# DISCORD
# ────────────────────────────────────────────────────────────

DISCORD_BOT_TOKEN="your_bot_token"
DISCORD_APPLICATION_ID="your_application_id"
DISCORD_GUILD_ID="your_guild_id"
DISCORD_VERSUS_CHANNEL_ID="your_versus_channel_id"
DISCORD_ADMIN_USER_ID="your_user_id"
# Role pinged when a duel opens and when results post. Empty = no ping.
DISCORD_DUEL_ALERT_ROLE_ID=""

# ────────────────────────────────────────────────────────────
# PLAYCHART API
# ────────────────────────────────────────────────────────────

PLAYCHART_API_BASE="https://www.playchart.gg/api/bot"
PLAYCHART_API_KEY="your_bot_api_key"

# ────────────────────────────────────────────────────────────
# SCHEDULING — DISCORD POLL
# ────────────────────────────────────────────────────────────

WEEKLY_POLL_CRON="0 18 * * 0"
WEEKLY_POLL_TZ="America/New_York"
# Hours the poll stays open. Defaults to 96 (4 days), min 1.
# Set to 1 in a test channel to check the close/result flow.
WEEKLY_POLL_DURATION_HOURS=""

# ────────────────────────────────────────────────────────────
# SCHEDULING — TWEET
# When Buffer publishes the tweet. Default Mon 08:00 ET.
# Independent from the Discord cron — the bot fires Sunday and
# schedules a Buffer post for whenever this resolves to next.
# ────────────────────────────────────────────────────────────

TWEET_SCHEDULE_CRON="0 8 * * 1"
TWEET_SCHEDULE_TZ="America/New_York"

# ────────────────────────────────────────────────────────────
# TWITTER INTEGRATION (optional — bot works fine without these)
# Setting ALL of these enables Twitter posting via Buffer + Cloudinary.
# Setting NONE / SOME disables it (fail-closed).
# ────────────────────────────────────────────────────────────

# Buffer — personal API token from Buffer dashboard
BUFFER_API_TOKEN=""
# The Buffer channel ID for your Twitter/X account specifically.
# Find via: query { channels(input: { organizationId: "..." }) { id name service } }
# Or run the helper: npm run buffer-channels
BUFFER_TWITTER_CHANNEL_ID=""

# Cloudinary — for hosting matchup images Buffer needs by URL
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ────────────────────────────────────────────────────────────
# STATS HEARTBEAT (optional — bot works fine without these)
# Reports server count and slash command usage to PlayChart's
# admin dashboard. Posts to the origin of PLAYCHART_API_BASE at
# /api/internal/bot-stats. Separate from PLAYCHART_API_KEY.
# Leave BOT_STATS_SECRET empty to skip heartbeats.
# ────────────────────────────────────────────────────────────

BOT_STATS_SECRET=""
# Minutes between heartbeats. Defaults to 60.
BOT_STATS_INTERVAL_MINUTES=""

# ────────────────────────────────────────────────────────────
# RUNTIME
# ────────────────────────────────────────────────────────────

NODE_ENV="development"
